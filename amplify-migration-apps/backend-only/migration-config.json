{
  "app": {
    "name": "backend-only",
    "description": "Backend-only app with auth, GraphQL API, storage, and function",
    "framework": "none"
  },
  "categories": {
    "api": {
      "type": "GraphQL",
      "schema": "schema.graphql",
      "authModes": ["API_KEY", "AMAZON_COGNITO_USER_POOLS"]
    },
    "auth": {
      "signInMethods": ["email"],
      "socialProviders": []
    },
    "storage": {
      "buckets": [
        {
          "name": "images",
          "access": ["auth", "guest"]
        }
      ]
    },
    "function": {
      "functions": [
        {
          "name": "quotegeneratorbe",
          "runtime": "nodejs",
          "template": "hello-world"
        }
      ]
    }
  }
}
